#!/usr/bin/env python3
"""Prove that E2E scenario failures propagate as non-zero top-level statuses."""

from __future__ import annotations

import shutil
import subprocess
import tempfile
from dataclasses import dataclass
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
RUNNER = ROOT / "scripts" / "e2e"
FIXTURES = ROOT / "tests" / "failure_fixtures"


@dataclass(frozen=True)
class Scenario:
    name: str
    fixture: str | None
    extra_args: tuple[str, ...] = ()
    piped: bool = False


SCENARIOS = (
    Scenario("e2e-assertion", "assertion.py.txt"),
    Scenario("e2e-crash", "crash.py.txt"),
    Scenario("e2e-timeout", "timeout.py.txt", ("--timeout=0.1",)),
    Scenario("e2e-teardown", "teardown.py.txt"),
    Scenario("e2e-zero-selection", "assertion.py.txt", ("-k", "zzz_no_matching_scenario_zzz")),
    Scenario("e2e-piped-assertion", "assertion.py.txt", piped=True),
)


def _run_scenario(scenario: Scenario, directory: Path) -> int:
    target = directory / scenario.name
    target.mkdir()

    if scenario.fixture is not None:
        shutil.copyfile(FIXTURES / scenario.fixture, target / "test_scenario_case.py")

    command = [str(RUNNER), str(target), *scenario.extra_args]
    if scenario.piped:
        shell_command = " ".join(subprocess.list2cmdline([part]) for part in command)
        completed = subprocess.run(
            ["bash", "-o", "pipefail", "-c", f"{shell_command} | cat >/dev/null"],
            cwd=ROOT,
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=20,
        )
    else:
        completed = subprocess.run(
            command,
            cwd=ROOT,
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=20,
        )
    return completed.returncode


def main() -> int:
    failures: list[str] = []
    with tempfile.TemporaryDirectory(prefix="local-recall-e2e-harness-") as raw_directory:
        directory = Path(raw_directory)
        for scenario in SCENARIOS:
            return_code = _run_scenario(scenario, directory)
            if return_code == 0:
                failures.append(scenario.name)

    if failures:
        print("E2E failure propagation broken for: " + ", ".join(failures))
        return 1

    print(f"verified {len(SCENARIOS)} E2E failure modes")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

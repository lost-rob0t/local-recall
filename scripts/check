#!/usr/bin/env bash
set -Eeuo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

./scripts/bootstrap
uv run --no-sync ruff format --check .
uv run --no-sync ruff check .
uv run --no-sync shellcheck scripts/bootstrap scripts/check scripts/e2e scripts/test scripts/run-pytest scripts/security-scan
uv run --no-sync pyright
./scripts/test
./scripts/verify-failure-modes
./scripts/verify-e2e-failure-modes
./scripts/security-scan
